# Backend environment variables — copy to backend/.env for local dev.

# Postgres connection string (local docker, or your Neon URL).
DATABASE_URL="postgresql://user:password@localhost:5432/whiteboard"

# Redis used by the socket.io adapter. Optional — if unset, the server runs
# as a single instance without the adapter. Local docker default below.
REDIS_URL="redis://localhost:6379"

# Optional. Comma-separated allowed origins, or "*" (default).
# CORS_ORIGIN="http://localhost:5173"

# Optional. Render sets PORT automatically; defaults to 3000 locally.
# PORT=3000
